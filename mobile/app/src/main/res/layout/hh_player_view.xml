<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView with a TextureView instead of the default SurfaceView.

  The viewer used to scale the video with Modifier.graphicsLayer, which only
  works on a TextureView: a SurfaceView is composited by the system into its
  own surface, so transforms never reach it. Video zoom is gone (it required
  a Compose gesture layer that swallowed every touch meant for the Media3
  controller), but the TextureView stays — it renders through the normal view
  hierarchy, which keeps the player inside the Compose z-order.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hh_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:surface_type="texture_view"
    app:use_controller="true" />
