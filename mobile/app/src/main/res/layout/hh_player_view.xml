<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView with a TextureView instead of the default SurfaceView.

  The viewer used to scale the video with Modifier.graphicsLayer, which only
  works on a TextureView: a SurfaceView is composited by the system into its
  own surface, so transforms never reach it. Video zoom is gone (it required
  a Compose gesture layer that swallowed every touch meant for the Media3
  controller), but the TextureView stays — it renders through the normal view
  hierarchy, which keeps the player inside the Compose z-order.

  controller_layout_id swaps in our arrangement of the stock Media3 controls:
  the fullscreen button (wired to the viewer's fullscreen state in VideoPage)
  sits to the left of the settings gear, and the gear is the right-most button
  so its popup lines up with it. See res/layout/hh_player_control_view.xml.

  HhPlayerView is a thin PlayerView subclass that recognises double-tap /
  press-and-hold gestures in the video area without swallowing the controller's
  own touches, and lets Compose own the fullscreen button's state.
-->
<me.erguotou.homehub.ui.components.HhPlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hh_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:controller_layout_id="@layout/hh_player_control_view"
    app:resize_mode="fit"
    app:surface_type="texture_view"
    app:use_controller="true" />
