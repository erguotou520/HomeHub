<?xml version="1.0" encoding="utf-8"?>
<!--
  HomeHub talks to the server over the WireGuard tunnel or the trusted home
  LAN; the server is never exposed to the public internet and currently has
  no TLS listener, so cleartext HTTP is permitted for all server addresses
  the app may point at (WG 10.0.0.1, LAN 192.168.x.x, localhost).
  TLS uses the system trust store, or the single self-signed certificate
  registered in Settings (see HttpClientFactory) once the server gains HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
